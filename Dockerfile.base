# syntax=docker/dockerfile:1

# Contains PHP + extensions + debug tools. No application code, so it
# never needs rebuilding on deploy. Build manually on the server:
# podman build --squash-all -f Dockerfile.base -t laravel-php-base:8.5.12-pgsql-v1 .
# Then Dockerfile just uses: FROM laravel-php-base:8.5.12-pgsql-v1

FROM php:8.5.12-cli-alpine3.24

RUN apk update \
    && apk add --no-cache supervisor libpq libzip \
    && apk add --no-cache --virtual .build-deps postgresql-dev libzip-dev \
    && docker-php-ext-install -j$(nproc) pdo_pgsql bcmath zip pcntl \
    && apk del .build-deps

RUN apk add --no-cache bash htop vim procps

WORKDIR /app

EXPOSE 8080
