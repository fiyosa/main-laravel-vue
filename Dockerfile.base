# syntax=docker/dockerfile:1

# Contains PHP + extensions + debug tools. No application code, so it
# never needs rebuilding on deploy. Build manually on the server:
# podman build --squash-all -f Dockerfile.base -t laravel-php-base:8.5-pgsql-v1 .
# Then Dockerfile just uses: FROM laravel-php-base:8.5-pgsql-v1

FROM php:8.5-cli-alpine

RUN apk add --no-cache postgresql-dev libzip-dev \
    && docker-php-ext-install -j$(nproc) pdo_pgsql bcmath zip pcntl \
    && apk del postgresql-dev libzip-dev

RUN apk add --no-cache htop vim procps

WORKDIR /app

EXPOSE 8080
